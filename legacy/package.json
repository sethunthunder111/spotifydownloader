{
  "name": "spotify-dl-node",
  "version": "1.0.0",
  "description": "Spotify Downloader CLI",
  "main": "spotify_node.js",
  "bin": {
    "spotify-dl": "./spotify_node.js"
  },
  "scripts": {
    "start": "node .",
    "build": "pkg . --targets node18-win-x64 --output spotify-dl.exe",
    "build:all": "pkg . --targets node20-linux-x64,node20-macos-x64,node20-win-x64 --output spotify-dl",
    "build:nexe": "nexe spotify_node.js --target windows-x64-22.15.0 --output spotify-dl.exe"
  },
  "pkg": {
    "scripts": [],
    "assets": [
      "Data/**/*",
      ".env",
      "node_modules/axios/dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "boxen": "^8.0.1",
    "colors": "^1.4.0",
    "conf": "^13.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "figlet": "^1.8.1",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.6.0",
    "node-id3": "^0.2.9",
    "node-notifier": "^10.0.1",
    "open": "^10.1.2",
    "ora": "^8.2.0",
    "play-sound": "^1.1.6",
    "sanitize-filename": "^1.6.3",
    "spotify-web-api-node": "^5.0.2",
    "yargs": "^17.7.2",
    "youtube-dl-exec": "^3.0.20"
  },
  "devDependencies": {
    "nexe": "^5.0.0-beta.4"
  }
}
